# Nareli Experience — environment variables (placeholder values only; never commit a filled .env)
# Base URL of the event-backend API (no trailing slash). Paste the real one from your backend deploy.
NEXT_PUBLIC_API_URL=https://api.example.com

# Resend key for the contact inquiry form (server-side only — never NEXT_PUBLIC_*)
RESEND_API_KEY=re_change_me

# Header injected by the hosting platform that holds the real client IP.
# Cloudflare: cf-connecting-ip   Vercel: x-real-ip
# Leave blank locally: all callers share one conservative rate-limit bucket.
# NEVER set this to x-forwarded-for — clients can forge that header.
TRUSTED_IP_HEADER=
